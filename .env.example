# Anthropic (default provider). Leave blank to use `ant auth login` credentials instead.
ANTHROPIC_API_KEY=

# Groq (free tier, OpenAI-compatible): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3-32b

# OpenRouter (OpenAI-compatible): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3-coder

# Optional settings
# MYPI_PROVIDER=anthropic        # anthropic | groq | openrouter
# MYPI_EFFORT=high               # Anthropic effort: low | medium | high | xhigh | max | none
# MYPI_MAX_TOKENS=64000          # Anthropic max output tokens per turn
# MYPI_BASH=C:\Program Files\Git\bin\bash.exe   # override the shell the bash tool uses
